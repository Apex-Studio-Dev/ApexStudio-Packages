+-		@echo "" >> motd
+-		@echo " - Root:    pkg install root-repo" >> motd
+-		@echo " - X11:     pkg install x11-repo" >> motd
+-		@echo "" >> motd
+-		@echo "For fixing any repository issues," >> motd
+-		@echo "try 'termux-change-repo' command." >> motd
+-    endif
