++	@echo "  apt search <pkg>    # Search packages" >> motd
++	@echo "  apt install <pkg>   # Install package" >> motd
++	@echo "  java -version       # Check Java" >> motd
++	@echo "  gradle --version    # Check Gradle" >> motd
+ 
+ 	@echo "" >> motd
+-	@echo "Report issues at https://termux.dev/issues" >> motd
